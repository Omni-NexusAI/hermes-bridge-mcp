HERMES_BRIDGE_PEER_ID=quest3
HERMES_BRIDGE_HOST=0.0.0.0
HERMES_BRIDGE_PORT=18084
HERMES_BRIDGE_SECURE_PORT=18443
HERMES_BRIDGE_AUTO_DISCOVERY=0
# For cross-network passive pairing, set AUTO_DISCOVERY=1 and backend=tailscale.
HERMES_BRIDGE_DISCOVERY_BACKEND=mdns
HERMES_BRIDGE_TAILSCALE_TAG=tag:hermes-bridge
# Android/Termux usually cannot call the Tailscale CLI directly; use API inventory for outbound discovery.
# Keep this token secret and rotate it according to Tailscale policy.
# HERMES_BRIDGE_TAILSCALE_PROVIDER=api
# HERMES_BRIDGE_TAILSCALE_API_TOKEN=tskey-...
# HERMES_BRIDGE_TAILNET=example.com
# HERMES_BRIDGE_ADVERTISE_ADDRESS=android-device.example.ts.net
HERMES_BRIDGE_PAIR_KEY=replace-with-same-secret-on-each-paired-agent
HERMES_BRIDGE_PEERS_CONFIG=$HOME/.hermes/bridge-state/peers.json
